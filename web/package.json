{
  "name": "campus-fabric-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "generate:contracts": "json2ts -i ../contracts/generated/contracts.schema.json -o src/generated/contracts.ts && json2ts -i ../contracts/generated/account-session.schema.json -o src/generated/account-session.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:client": "node --experimental-transform-types --test tests/api.test.mjs",
    "test:ui": "tsx --tsconfig tsconfig.json --test tests/*.test.tsx"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
