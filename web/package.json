  },
  "dependencies": {"react": "19.3.1", "react-dom": "19.3.1"},
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "json-schema-to-typescript": "16.0.0"
  }
}
