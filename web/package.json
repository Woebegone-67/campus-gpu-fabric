{
  "name": "campus-fabric-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0 <23"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
