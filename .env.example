# Export these in the launching shell. This file is not auto-loaded.
# make api uses HOST/PORT; make web uses PORT/WEB_PORT.
FABRIC_INSTANCE=owner-a
FABRIC_DATA_DIR=runtime/owner-a
FABRIC_MODE=logical_simulation
FABRIC_SCHEDULING_MODE=builtin
# Explicit simulated inventory: first DB initialization only, never reloaded after reset.
FABRIC_INVENTORY_FILE=configs/cp1_inventory.json
# Optional server-only file mapping tokens to actor/role/owner; no file => local X-Owner.
# FABRIC_AUTH_FILE=runtime/demo/auth.json
# Disabled unless explicitly supplied. Never use VITE_* for test credentials.
FABRIC_TEST_KEY=
